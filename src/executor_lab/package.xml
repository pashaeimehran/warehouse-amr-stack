<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>executor_lab</name>
  <version>0.2.0</version>
  <description>Callback starvation experiment: a 50 Hz timer next to a slow CPU-bound callback under single and multi-threaded executors, with shared and separate callback groups.</description>
  <maintainer email="mehran.pashaei.mp@gmail.com">Mehran Pashaei</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>robot_core</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
