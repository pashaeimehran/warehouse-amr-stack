<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>warehouse_sim</name>
  <version>0.2.0</version>
  <description>Gazebo Harmonic warehouse world: aisles, shelves with KLT boxes, stations A and B, dock, drop-off, AprilTags on shelf ends; generated from one layout script with its landmark map.</description>
  <maintainer email="mehran.pashaei.mp@gmail.com">Mehran Pashaei</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_sim</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-opencv</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>apriltag</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
