<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qos_lab</name>
  <version>0.2.0</version>
  <description>QoS experiment: loss and one-way latency for 3 QoS profiles x 2 payload sizes x 2 RMWs (Fast DDS, Cyclone DDS), plus a silent QoS incompatibility case.</description>
  <maintainer email="mehran.pashaei.mp@gmail.com">Mehran Pashaei</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>robot_core</depend>

  <exec_depend>rmw_cyclonedds_cpp</exec_depend>
  <exec_depend>rmw_fastrtps_cpp</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
